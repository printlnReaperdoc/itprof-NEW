# ==============================================================================
# Backend .gitignore
# ==============================================================================

# Dependencies
node_modules/

# Environment files
.env
.env.local
.env.*.local

# Uploads and temporary files
uploads/*
!uploads/.gitkeep
storage/*
!storage/.gitkeep
temp/
tmp/

# Logs
logs/
*.log
npm-debug.log*

# Test coverage
coverage/

# OS and IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/

